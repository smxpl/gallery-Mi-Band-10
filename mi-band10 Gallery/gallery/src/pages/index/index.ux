  flex-direction: column;
  width: 100%;
  height: 100%;
}

.panel {
  flex-direction: column;
  width: 100%;
  height: 100%;
}

.layer-stack {
  width: 100%;
  height: 100%;
}

.gallery-bg {
  background-color: #000000;
}

/* The stack automatically isolates this click wrapper away from your photo elements */
.top-row-overlay {
  width: 100%;
  height: 80px;
  margin-top: 15px;
  justify-content: center;
  align-items: center;
}

.info-button {
  width: 50px; /* Sizing slightly expanded for reliable touch targets */
  height: 50px;
  border-radius: 25px;
  background-color: #333333;
  justify-content: center;
  align-items: center;
}

.info-icon-text {
  color: #ffffff;
  font-size: 24px;
  font-weight: bold;
}

.gallery-clicker {
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 100%;
}

.slide {
  width: 100%;
  height: 100%;
  justify-content: center;
  align-items: center;
}

.gallery-image {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

/* About Branding Panel View Components */
.about-bg {
  background-color: #000000;
}

.about-content {
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 100%;
}

.avatar-circle {
  width: 100px;
  height: 100px;
  border-radius: 50px;
  border-width: 3px;
  border-color: #ff6b00;
  justify-content: center;
  align-items: center;
  margin-bottom: 20px;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.creator-title {
  color: #888888;
  font-size: 20px;
  margin-bottom: 5px;
}

