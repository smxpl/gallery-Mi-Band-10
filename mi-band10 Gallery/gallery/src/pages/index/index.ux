<template>
  <div class="main-container">
    <!-- VIEW A: THE VISUAL GALLERY -->
    <div if="{{ currentView === 'gallery' }}" class="panel gallery-bg">
      
      <!-- Using a native Stack layout element lets hardware layers separate cleanly -->
      <stack class="layer-stack">
        
        <!-- Touch Layer 1: Bottom Layer - Dedicated Image Slider Clicker -->
        <div class="gallery-clicker" onclick="nextImage">
          <div if="{{imageIndex === 1}}" class="slide"><image src="/common/img1.png" class="gallery-image"></image></div>
          <div if="{{imageIndex === 2}}" class="slide"><image src="/common/img2.png" class="gallery-image"></image></div>
          <div if="{{imageIndex === 3}}" class="slide"><image src="/common/img3.png" class="gallery-image"></image></div>
          <div if="{{imageIndex === 4}}" class="slide"><image src="/common/img4.png" class="gallery-image"></image></div>
          <div if="{{imageIndex === 5}}" class="slide"><image src="/common/img5.png" class="gallery-image"></image></div>
          <div if="{{imageIndex === 6}}" class="slide"><image src="/common/img6.png" class="gallery-image"></image></div>
          <div if="{{imageIndex === 7}}" class="slide"><image src="/common/img7.png" class="gallery-image"></image></div>
          <div if="{{imageIndex === 8}}" class="slide"><image src="/common/img8.png" class="gallery-image"></image></div>
          <div if="{{imageIndex === 9}}" class="slide"><image src="/common/img9.png" class="gallery-image"></image></div>
          <div if="{{imageIndex === 10}}" class="slide"><image src="/common/img10.png" class="gallery-image"></image></div>
        </div>

        <!-- Touch Layer 2: Top Layer - Fully Independent Row for Info Button -->
        <div class="top-row-overlay">
          <div class="info-button" onclick="goToAbout">
            <text class="info-icon-text">i</text>
          </div>
        </div>

      </stack>

    </div>

    <!-- VIEW B: THE ABOUT BRANDING SCREEN -->
    <div if="{{ currentView === 'about' }}" class="panel about-bg" onswipe="handleSwipe">
      <div class="about-content">
        <div class="avatar-circle">
          <image src="/common/icon.png" class="avatar-img"></image>
        </div>
        
        <text class="creator-title">Created By</text>
        <text class="creator-name">yourmombeanbo       (◣ _ ◢)メ</text> 
        
        <text class="hint-text">Swipe Right to Return</text>
      </div>
    </div>
  </div>
</template>

<script>
export default {
  private: {
    currentView: 'gallery', 
    imageIndex: 1,          
    totalImages: 10 
  },

  nextImage() {
    this.imageIndex++
    if (this.imageIndex > this.totalImages) {
      this.imageIndex = 1
    }
  },

  goToAbout() {
    this.currentView = 'about'
  },

  handleSwipe(evt) {
    if (evt.direction === 'right') {
      this.currentView = 'gallery'
    }
  }
}
</script>

